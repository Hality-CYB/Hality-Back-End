# .env de produção do ~/hality (usado pelo compose e pela API).
# Copie para ~/hality/.env e preencha. Nunca commite o arquivo preenchido.
#
# Os valores públicos abaixo usam o domínio HTTPS da aplicação.
# Para produção, configure ENVIRONMENT=production e EMAIL_PROVIDER=resend
# com RESEND_* preenchidos. O back recusa production sem HTTPS e Resend;
# nesse ambiente, o cookie de sessão é `secure` (não funciona em HTTP).

# --- Acesso público (Caddy + front) ---
# Domínio liga HTTPS automático; ":80" serve só HTTP pelo IP.
DOMAIN=hality-cyb.duckdns.org
PUBLIC_URL=https://hality-cyb.duckdns.org

# --- API (mesmas variáveis do hality-back/.env.example) ---
PROJECT_NAME=hality-back
API_V1_PREFIX=/api/v1
ENVIRONMENT=development
DEBUG=false
CORS_ORIGINS=["https://hality-cyb.duckdns.org"]

POSTGRES_USER=hality
# Gere com: openssl rand -hex 24
POSTGRES_PASSWORD=
POSTGRES_DB=hality
DB_ECHO=false

# Gere com: openssl rand -hex 32
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://hality-cyb.duckdns.org/api/v1/auth/google/callback
GOOGLE_FRONTEND_REDIRECT_URL=https://hality-cyb.duckdns.org/login/google

IDENTITY_TOKEN_BASE_URL=https://hality-cyb.duckdns.org

EMAIL_PROVIDER=noop
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_TEST_RECIPIENT=

# Saída `hality_ai_url` do Terraform (EC2 privada do modelo).
HALITY_AI_URL=http://10.20.2.174:8000
