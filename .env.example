PROJECT_NAME=hality-back
API_V1_PREFIX=/api/v1
ENVIRONMENT=development
DEBUG=true

CORS_ORIGINS=["http://localhost:3000"]

# PostgreSQL — ajuste para o seu ambiente local
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/hality

# JWT — use uma chave forte e única em produção (ex.: openssl rand -hex 32)
SECRET_KEY=CHANGE-ME-IN-PRODUCTION
ACCESS_TOKEN_EXPIRE_MINUTES=1440
