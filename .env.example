PROJECT_NAME=hality-back
API_V1_PREFIX=/api/v1
ENVIRONMENT=development
DEBUG=true

CORS_ORIGINS=["http://localhost:3000"]

# PostgreSQL — ajuste para o seu ambiente local
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=hality
POSTGRES_PASSWORD=hality
POSTGRES_DB=hality
DB_ECHO=false

# Seeds
SEED_PASSWORD="hality123"

# JWT — gere uma chave forte e única (ex.: openssl rand -hex 32)
# Obrigatório: sem este valor a aplicação não inicializa
SECRET_KEY=CHANGE-ME-IN-PRODUCTION
ALGORITHM=HS256

# Access token (JWT, curto — vai em toda chamada) e refresh token (opaco,
# em banco — só usado por POST /auth/refresh). Ver app/auth/users.py.
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
