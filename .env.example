PROJECT_NAME=hality-back
API_V1_PREFIX=/api/v1
ENVIRONMENT=development
# Booleanos aceitos: true/false, 1/0, yes/no ou on/off (sem diferenciar maiúsculas)
DEBUG=true

CORS_ORIGINS=["http://localhost:3000"]

# PostgreSQL — ajuste para o seu ambiente local
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=hality
POSTGRES_PASSWORD=hality
POSTGRES_DB=hality
# Mesmos valores booleanos aceitos em DEBUG
DB_ECHO=false

# Seeds
SEED_PASSWORD="hality123"

# JWT — gere uma chave forte e única com pelo menos 32 bytes (ex.: openssl rand -hex 32)
# Obrigatório: sem este valor a aplicação não inicializa. O placeholder abaixo tem
# comprimento seguro para testes locais, mas deve ser substituído fora do desenvolvimento.
SECRET_KEY=CHANGE-ME-IN-PRODUCTION-USE-32-BYTES-MINIMUM
ALGORITHM=HS256

# Access token (JWT, curto — vai em toda chamada) e refresh token (opaco,
# em banco — só usado por POST /auth/refresh). Ver app/auth/users.py.
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# Login com Google (opcional — sem estas quatro variáveis o fluxo fica desligado).
# O client secret fica só no backend. Crie as credenciais "Aplicativo da Web" no
# console do Google Cloud e cadastre GOOGLE_REDIRECT_URI como URI de redirecionamento.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
# Página do frontend que recebe ?code=... (troca) ou ?erro=... ao fim do callback.
GOOGLE_FRONTEND_REDIRECT_URL=http://localhost:3000/login/google

# Identidade: validade dos convites e URL da tela que recebe o token
IDENTITY_TOKEN_EXPIRE_MINUTES=60
IDENTITY_TOKEN_BASE_URL=http://localhost:3000
EMAIL_PROVIDER=noop
# Para testar o Resend localmente: EMAIL_PROVIDER=resend, chave privada abaixo,
# remetente de testes e o email da conta Resend como único destinatário permitido.
# Em produção: ENVIRONMENT=production, URL HTTPS pública, domínio verificado,
# RESEND_TEST_RECIPIENT vazio e chave própria de envio.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_TEST_RECIPIENT=

# Modelo de inferência (API hality-ai). No compose é o nome do serviço na rede
# interna; rodando o back fora do Docker, aponte para http://localhost:8000.
# Vazio = usa o mock de desenvolvimento (diagnostico_mock).
HALITY_AI_URL=http://hality-ai:8000
